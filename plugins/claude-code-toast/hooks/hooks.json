{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "async": true,
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/notify-toast.sh 'セッション開始' start"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "async": true,
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/notify-toast.sh '応答完了' ok"
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "async": true,
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/notify-toast.sh 'エラーで停止' error"
          }
        ]
      }
    ],
    "PermissionDenied": [
      {
        "hooks": [
          {
            "type": "command",
            "async": true,
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/notify-toast.sh 'ツール実行が拒否された' no"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "async": true,
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/notify-toast.sh 'コンテキストを圧縮中' clean"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "async": true,
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/notify-toast.sh 'セッション終了' end"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt",
        "hooks": [
          {
            "type": "command",
            "async": true,
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/notify-toast.sh 'ツール実行の承認待ち' halt"
          }
        ]
      },
      {
        "matcher": "agent_needs_input",
        "hooks": [
          {
            "type": "command",
            "async": true,
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/notify-toast.sh 'エージェントが入力待ち' info"
          }
        ]
      },
      {
        "matcher": "elicitation_dialog",
        "hooks": [
          {
            "type": "command",
            "async": true,
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/notify-toast.sh 'MCP が入力待ち' notice"
          }
        ]
      },
      {
        "matcher": "elicitation_url_dialog",
        "hooks": [
          {
            "type": "command",
            "async": true,
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/notify-toast.sh 'MCP が URL 認証待ち' warn"
          }
        ]
      }
    ]
  }
}
